{
  "name": "xhs-article-to-images",
  "version": "0.1.0",
  "description": "Agent-assisted Markdown article to Xiaohongshu 3:4 image cards workflow.",
  "license": "MIT",
  "author": "Bozhou",
  "repository": {
    "type": "git",
    "url": "https://github.com/bozhouDev/xhs-article-to-images.git"
  },
  "homepage": "https://github.com/bozhouDev/xhs-article-to-images#readme",
  "bugs": {
    "url": "https://github.com/bozhouDev/xhs-article-to-images/issues"
  },
  "type": "commonjs",
  "bin": {
    "xhs-init": "./scripts/init-task.cjs",
    "xhs-render": "./scripts/render.cjs"
  },
  "scripts": {
    "init:task": "node scripts/init-task.cjs",
    "render": "node scripts/render.cjs",
