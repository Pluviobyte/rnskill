    "preview/styles.css",
    "preview/styles-d.css",
    "preview/styles-e.css",
    "preview/output"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "keywords": [
    "xiaohongshu",
    "rednote",
    "markdown",
    "playwright",
    "agent-skill",
    "carousel"
  ]
